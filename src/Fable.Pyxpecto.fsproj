<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Kevin Frey</Authors>
    <PackageId>Huwmanatee.Fable.Pyxpecto</PackageId>
    <Description>Fable python unit tests, like Fable.Mocha with Expecto syntax.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>fsharp fable fable-library fable-python fable-dotnet fable-javascript
      fable-typescript testing unit-testing</PackageTags>
    <PackageProjectUrl>https://github.com/huwmanatee/Fable.Pyxpecto</PackageProjectUrl>
    <RepositoryUrl>https://github.com/huwmanatee/Fable.Pyxpecto</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ChangelogFile>../CHANGELOG.md</ChangelogFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EasyBuild.PackageReleaseNotes.Tasks">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <Compile Include="Prelude.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Assertion.fs" />
    <Compile Include="CommandLine.fs" />
    <Compile Include="TestDsl.fs" />
    <Compile Include="Expect.fs" />
    <Compile Include="Suspect.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="PyxpectoRunner.fs" />
    <!-- Last: its AutoOpen `!!` must not shadow TranspilerHelper's inside this library. -->
    <Compile Include="Interop.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <!-- Python-only: compiling it for another Fable target fails on Fable.Python's own sources. -->
    <PackageReference Include="Fable.Python" Condition="'$(FABLE_COMPILER_PYTHON)' == 'true'" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="*.fsproj; **\*.fs; **\*.fsi" Exclude="bin\**; obj\**" PackagePath="fable\" />
  </ItemGroup>

  <PropertyGroup>
    <PythonDependencies>
      <Package Name="fable-library" Version="&gt;= 5.15.0 &lt; 6.0.0" ResolutionStrategy="Max" />
    </PythonDependencies>
  </PropertyGroup>
</Project>
